{
  "ConnectionStrings": {
    "Default": "Data Source=YOUR_SQL_SERVER;Initial Catalog=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET",
    "Issuer": "MedSafeHub",
    "Audience": "MedSafeHub",
    "ExpiryMinutes": "1440",
    "RefreshTokenExpiryDays": "7"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "FileStorage": {
    "RootPath": "App_Data\\IncidentAttachments"
  },
  "Frontend": {
    "BaseUrl": "https://medication-reporting-system.netlify.app"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
